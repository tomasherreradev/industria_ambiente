APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=muestreo_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PDF facturas (SDK AFIP devuelve URL S3): si producción no alcanza S3, DomPDF hace fallback automático.
# Forzar solo DomPDF (sin CreatePDF ni S3): FACTURA_PDF_SOLO_DOMPDF=true
FACTURA_PDF_SOLO_DOMPDF=false
# Si falla SSL al descargar desde S3, probar false solo en ese servidor (menos seguro).
FACTURA_PDF_SSL_VERIFY=true

# Plantilla PDF factura (resources/views/facturacion/bill.html): textos y letra del comprobante
# EMPRESA_SUBTITULO="Laboratorio de..."
# EMPRESA_CONTACTO_LINEA="Merlo 10\nTel ...\n..."
# FACTURA_TIPO_LETRA=A
# FACTURA_CODIGO_COMPROBANTE=1
# (Si FACTURA_CODIGO_COMPROBANTE vacío: B→6, C→11, otro→1)
# EMPRESA_CONDICION_IVA="Responsable Inscripto"
# FACTURA_MONEDA_SIMBOLO=$
# FACTURA_IVA_ALICUOTA=21
# FACTURA_LEYENDA_TIPO_CAMBIO="Al solo efecto impositivo, el tipo de cambio..."
# FACTURA_OT_NUMERO=00102937
# FACTURA_OT_NUMEROS="00102251,00102252,00102253"
# FACTURA_OC_NUMERO=00001-00007147
# FACTURA_SOLICITANTE=Nombre
# FACTURA_CLIENTE_CONDICION_IVA=Consumidor Final
# FACTURA_CLIENTE_ZONA=
# FACTURA_CLIENTE_MOV=
# FACTURA_CLIENTE_ORIGEN=
# FACTURA_CLIENTE_R=
# FACTURA_CLIENTE_V=
# Vencimiento pago (barra "Vto.") — si no se define, igual al Vto. C.A.E.:
# FACTURA_FECHA_VTO_PAGO=10/05/2026
# O sumar días a la fecha de emisión de la factura:
# FACTURA_VTO_PAGO_DIAS=30
# Logo pie AFIP (opcional): public/assets/img/afip_logo.png
#
# Facturación electrónica (Afip SDK + WSFE homologación):
# Certificado de testing (OpenSSL + CSR en ARCA): https://docs.afipsdk.com/recursos/tutoriales-pagina-de-arca/obtener-certificado-de-testing
# Alternativa: php artisan afip:create-cert-dev (automatización Afip SDK).
# El .csr no es el certificado; el .crt debe empezar con -----BEGIN CERTIFICATE-----.
# Luego autorizar wsfe en homologación (ARCA o --authorize-ws en el comando).
#
# AFIPSDK_ACCESS_TOKEN=...
# AFIP_PRODUCTION=false
#
# Opción A — solo token (CUIT de testing del SDK, sin PEM), ver API TA:
# https://docs.afipsdk.com/integracion/api
# AFIP_CUIT=20409378472
# (no definas AFIP_CERT_PATH ni AFIP_KEY_PATH)
# Tras cambiar .env: php artisan config:clear (o config:cache de nuevo si lo usás).
#
# Opción B — tu CUIT + PEM:
# AFIP_CUIT=20123456789
# AFIP_CERT_PATH=storage/certificates/certificado.crt
# AFIP_KEY_PATH=storage/certificates/clave.key
# AFIP_PASSPHRASE=
# AFIP_PTO_VTA=1
# AFIP_PUNTO_VENTA=1
# AFIP_CBTE_TIPO=1
# Si app.afipsdk.com falla al pedir el TA: WSAA+WSFE directo (requiere PEM + extension=soap):
# AFIP_DIRECT_WSFE=false

# Firma digital (alpha2000/digilogix)
# persona_fisica: NO enviar CuitOrganizacion (solo CUIL) - recomendado por soporte para pruebas con custodia
# organizacion: enviar CuitOrganizacion
FIRMA_DIGITAL_MODO=persona_fisica
